# Frontend (Vite). Only public values belong here; anything prefixed VITE_ is bundled into the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# URL of the AeroNex API server. Leave empty to run the built-in, clearly-labelled simulation
# (no accounts-backed features such as synced alerts, settings or the data pipeline page).
VITE_API_BASE_URL=http://localhost:5000
