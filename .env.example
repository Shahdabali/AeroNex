# Frontend (Vite). Only public values belong here; anything prefixed VITE_ is bundled into the browser.
# Never put the scraper URL/token, service-role keys or any secret in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# URL of the AeroNex server. Without it a PRODUCTION build shows "no data source" (it never shows made-up fares).
VITE_API_BASE_URL=http://localhost:5000

# Demo deployments only: allow the built-in client-side simulation when no server is connected.
# It is always labelled SIMULATED. Development (`npm run dev`) allows it automatically.
# VITE_ALLOW_SIMULATION=true
