PORT=5000

# Supabase (server-side only; the service-role key must never reach the browser).
# The server uses it to verify user sessions and to delete accounts.
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Browser origins allowed to call this API (comma separated). localhost is always allowed for development.
CORS_ORIGINS=https://your-frontend.example.com
# Set to the number of reverse-proxy hops (e.g. 1 on Render/Vercel) so rate limiting sees real client IPs.
TRUST_PROXY=1

# ── Fare source: the scraper service (recommended) ──────────────────────────────────────────────────────────────
# Where the AeroNex server reads collected fares from. Server-side only: never expose these to the browser.
SCRAPER_API_URL=http://127.0.0.1:8000
# Must equal SCRAPER_API_TOKEN on the scraper service.
SCRAPER_API_TOKEN=
# How often this server re-reads the scraper (seconds, min 10). The scraper itself refreshes on its own schedule.
SCRAPER_POLL_SECONDS=30

# Who may start a manual scrape (comma-separated emails). In production an empty list means nobody.
ADMIN_EMAILS=

# Set NODE_ENV=production in production. In production simulated fares are refused unless explicitly allowed.
NODE_ENV=development
# Development aid ONLY: allow the modelled fare simulation when no real source is configured (default outside production).
# ALLOW_SIMULATED_DATA=true

# ── AeroNex AI (optional). Without a key, analysis uses deterministic, data-grounded rules. ────────────────────
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_PER_MINUTE=30
AI_INSIGHT_CACHE_MINUTES=30

# ── Legacy / alternative providers ──────────────────────────────────────────────────────────────────────────────
DATA_REFRESH_INTERVAL_SECONDS=30
# How often the index is written to Supabase when NOT using the scraper (seconds)
INDEX_PERSIST_SECONDS=300

# Optional real market fares via the Amadeus Self-Service API (used only if SCRAPER_API_URL is not set).
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_HOST=https://test.api.amadeus.com
# AMADEUS_ROUTES_PER_CYCLE=4

# Where per-user settings, alerts, notifications and support tickets are stored (default: server/data).
# Use a persistent disk in production.
# AERONEX_DATA_DIR=/var/data/aeronex
